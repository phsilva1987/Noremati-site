  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Preciso ter experiência prévia com Pilates?",
        "acceptedAnswer": { "@type": "Answer", "text": "Não. As aulas são adaptadas ao nível de cada pessoa, do iniciante ao avançado, respeitando seu corpo e seu ritmo desde a primeira sessão." }
      },
      {
        "@type": "Question",
        "name": "O que devo vestir? Preciso de tênis?",
        "acceptedAnswer": { "@type": "Answer", "text": "Vista roupas confortáveis que permitam liberdade de movimento. O Pilates Clássico é praticado descalço ou com meia antiderrapante — não é necessário levar tênis." }
      },
      {
        "@type": "Question",
        "name": "Quantas vezes por semana devo praticar?",
        "acceptedAnswer": { "@type": "Answer", "text": "Depende do seu objetivo e da sua rotina. De forma geral, entre 2 e 3 aulas semanais trazem resultados consistentes — fale com a Fabiana para uma orientação personalizada." }
      },
      {
        "@type": "Question",
        "name": "Atende crianças e idosos também?",
        "acceptedAnswer": { "@type": "Answer", "text": "Sim. As aulas são personalizadas para adultos, crianças e idosos, sempre respeitando o corpo e o objetivo de cada aluno." }
      },
      {
        "@type": "Question",
        "name": "Qual a diferença do Pilates Clássico para outros tipos de pilates?",
        "acceptedAnswer": { "@type": "Answer", "text": "O Pilates Clássico segue a sequência e os princípios originais criados por Joseph Pilates, priorizando a precisão do movimento antes da repetição — diferente de adaptações mais modernas do método." }
      },
      {
        "@type": "Question",
        "name": "Como faço para agendar minha primeira aula?",
        "acceptedAnswer": { "@type": "Answer", "text": "É simples: clique em \"Falar com a Fabiana\" e converse diretamente pelo WhatsApp para tirar dúvidas e combinar o melhor dia e horário para você." }
      }
    ]
  }
  </script>

  <style>
    :root{
      --bg:#f7f2e8;--paper:#fffdf8;--ink:#2c2117;--muted:#6f655b;
      --gold:#a77a34;--gold-btn:#8f6a2e;--gold2:#c6a260;--line:#dfd1bd;--dark:#2d2116;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,Arial,sans-serif}
    .wrap{width:min(1180px,calc(100% - 40px));margin:auto}
    img{display:block;max-width:100%;height:auto}
    h1,h2,h3{font-family:"Cormorant Garamond",serif;margin:0;font-weight:600;line-height:.94}
    .eyebrow{font-size:12px;letter-spacing:.23em;text-transform:uppercase;color:var(--gold);font-weight:600}
    .eyebrow--light{color:#d8b777}
    .btn{display:inline-flex;align-items:center;gap:10px;padding:14px 22px;border-radius:999px;background:var(--gold-btn);color:#fff;text-decoration:none;font-weight:600;box-shadow:0 9px 24px rgba(112,78,27,.18)}
    .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .nav-actions{display:flex;align-items:center;gap:12px}
    .nav-toggle{display:none;flex-direction:column;justify-content:center;align-items:center;gap:5px;width:40px;height:40px;padding:0;border:none;background:none;cursor:pointer;flex:none}
    .nav-toggle span{display:block;width:22px;height:2px;background:var(--ink);border-radius:2px;transition:transform .25s ease,opacity .25s ease}
    .nav-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
    .nav-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}
    .nav-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

    /* Header */
    header{position:sticky;top:0;z-index:20;background:rgba(255,253,248,.95);backdrop-filter:blur(10px);border-bottom:1px solid #eadfcd}
    .nav{height:86px;display:flex;align-items:center;justify-content:space-between;gap:24px}
    .brand img{height:58px;width:auto}
    .navlinks{display:flex;gap:4px;list-style:none;margin:0;padding:0}
    .navlinks a{text-decoration:none;color:var(--ink);font-size:13px;padding:9px 16px;border-radius:999px;display:inline-block;transition:background-color .25s ease,color .25s ease,box-shadow .25s ease}
    .navlinks a:hover{color:var(--gold);background:rgba(167,122,52,.09);box-shadow:0 6px 16px rgba(167,122,52,.16)}
    .navlinks a.active{color:var(--gold);background:rgba(167,122,52,.12);box-shadow:0 6px 16px rgba(167,122,52,.2)}

    /* Hero */
    .hero{background:linear-gradient(90deg,#fffaf1 0 52%,#efe3d2 52% 100%)}
    .hero-grid{display:grid;grid-template-columns:.56fr .44fr;min-height:610px}
    .hero-copy{padding:46px 72px 42px 0;display:flex;flex-direction:column;justify-content:center}
    .hero h1{font-size:66px;margin:8px 0 14px;line-height:.9}
    .hero h1 span{display:block}
    .hero-intro{font-family:"Cormorant Garamond",serif;font-size:28px;line-height:1.08;margin-bottom:14px}
    .hero p{color:var(--muted);line-height:1.55;font-size:14px}
    .hero-photo{position:relative;overflow:hidden;background:#efe3d2;display:flex;align-items:center;justify-content:center;padding:64px 46px}
    .hero-photo img{width:min(88%,470px);max-height:500px;object-fit:contain;object-position:center;border-radius:22px;box-shadow:0 22px 60px rgba(51,38,23,.14)}
    .hero-quote{margin-top:22px;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:24px;line-height:1.08;color:#6d4b20}
    .hero-quote small{font-family:Inter,sans-serif;display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-style:normal;margin-top:8px}

    /* Credentials */
    .creds{display:grid;gap:18px;margin-top:24px}
    .cred{display:grid;grid-template-columns:40px 1fr;gap:14px}
    .cred .icon{width:40px;height:40px;border-radius:50%;border:1px solid var(--gold2);display:flex;align-items:center;justify-content:center;flex:none}
    .cred .icon svg{width:19px;height:19px;stroke:var(--gold);fill:none}
    .cred strong{display:block;font-size:13px;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px}
    .cred p{margin:0;font-size:13px;line-height:1.45}

    section{padding:88px 0}

    /* Lineage */
    .lineage{text-align:center;background:#fffaf1}
    .lineage h2{font-size:56px;margin:8px auto 12px}
    .lineage .intro{max-width:900px;margin:0 auto 52px;color:var(--muted);line-height:1.55}
    .lineage-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:58px;align-items:start}
    .person{position:relative}
    .person:not(:last-child)::after{content:"";position:absolute;right:-42px;top:150px;width:28px;height:1px;background:var(--gold)}
    .portrait{width:100%;aspect-ratio:1.3/1;border-radius:18px;object-fit:cover;object-position:center 32%;box-shadow:0 18px 40px rgba(51,38,23,.09)}
    .person:nth-child(1) .portrait,.person:nth-child(2) .portrait{object-position:center top}
    .person h3{font-size:32px;margin-top:18px}
    .role{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);margin:6px 0 12px;font-weight:600}
    .person p{color:var(--muted);font-size:14px;line-height:1.5;max-width:290px;margin:0 auto}
    .lineage-end{font-family:"Cormorant Garamond",serif;font-size:34px;font-style:italic;color:var(--gold);margin-top:48px}

    /* Classic */
    .classic{background:var(--paper)}
    .classic-grid{display:block;max-width:1100px;margin:0 auto}
    .classic-copy{text-align:center}
    .classic h2{font-size:64px;margin:10px auto 24px;max-width:900px}
    .classic-copy>p{color:var(--muted);font-size:18px;line-height:1.55;max-width:860px;margin:0 auto}
    .features{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:46px;text-align:left}
    .feature{border-top:1px solid var(--line);padding-top:20px}
    .feature strong{font-size:18px}
    .feature p{font-size:14px;margin:8px 0 0;color:var(--muted);line-height:1.5}

    /* Studio */
    .studio{background:#f4ede1}
    .studio-head{max-width:760px;margin-bottom:38px}
    .studio-head h2{font-size:58px;margin:8px 0 14px}
    .studio-head p{color:var(--muted);line-height:1.55}
    .studio-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:46px;align-items:stretch}
    .studio-view{border-radius:22px;overflow:hidden;min-height:520px}
    .studio-view img{width:100%;height:100%;object-fit:cover}
    .studio-panel{background:#fffaf1;padding:44px;border-radius:22px;display:flex;flex-direction:column;justify-content:center}
    .studio-panel h3{font-size:42px;margin-bottom:12px}
    .studio-panel p{color:var(--muted);line-height:1.6}
    .studio-sign{font-family:"Cormorant Garamond",serif;font-size:28px;font-style:italic;color:var(--gold);margin-top:22px}
    .studio-sign small{font-family:Inter,sans-serif;font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-style:normal;display:block}

    /* FAQ */
    .faq{background:var(--paper)}
    .faq h2{font-size:52px;margin:8px 0 40px;max-width:760px}
    .faq-list{max-width:820px}
    .faq-item{border-top:1px solid var(